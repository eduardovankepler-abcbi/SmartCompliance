{
  "name": "smart-compliance-mvp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend-angular",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend-angular run start",
    "dev:frontend:legacy": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend run start",
    "build": "npm --prefix frontend-angular run build",
    "build:frontend": "npm --prefix frontend-angular run build",
    "build:frontend:legacy": "npm --prefix frontend run build",
    "test:e2e": "npm --prefix frontend-angular run e2e",
    "test:e2e:legacy": "npm --prefix frontend run e2e",
    "test": "npm --prefix backend run test && npm --prefix frontend-angular run parity:strict",
    "verify": "npm run test && npm run build:frontend",
    "qa:published": "npm --prefix backend run homologate:wave4:readonly && npm --prefix frontend-angular run smoke:published"
  },
  "overrides": {
    "vite": "6.4.5",
    "@angular/build@21.2.28": {
      "vite": "7.3.7",
      "undici": "7.30.1"
    },
    "express@4.22.3": {
      "body-parser": "1.20.9"
    }
  }
}
