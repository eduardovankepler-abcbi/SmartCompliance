NODE_ENV=production
PORT=4000
APP_VERSION=release-YYYYMMDD
LOG_FORMAT=json
STORAGE_MODE=mysql
TRUST_PROXY=1
AUTH_SECRET=change-this-to-a-strong-secret-with-32-plus-chars
AUTH_LOGIN_WINDOW_MS=600000
AUTH_LOGIN_LOCK_MS=900000
AUTH_MAX_FAILED_LOGINS=5
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=smart_compliance
MYSQL_SSL_MODE=required
MYSQL_SSL_REJECT_UNAUTHORIZED=false
CORS_ORIGIN=https://your-local-production-frontend.example.com
DATA_DIR=/var/lib/smart-compliance/data
BACKUP_DIR=/var/backups/smart-compliance
BACKUP_RETENTION_DAYS=7
MYSQLDUMP_PATH=mysqldump
MYSQL_CLIENT_PATH=mysql

