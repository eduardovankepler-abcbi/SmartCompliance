{
  "name": "frontend-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:budget": "ng build --stats-json && npm run bundle:budget",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "e2e": "playwright test",
    "visual:parity": "playwright test --config=playwright.visual.config.ts",
    "visual:report": "node scripts/visual-report.mjs",
    "visual:parity:report": "npm run visual:parity && npm run visual:report",
    "parity:matrix": "node scripts/parity-matrix.mjs",
    "parity:check": "node scripts/parity-matrix.mjs --fail-on-missing",
    "parity:strict": "node scripts/parity-matrix.mjs --fail-on-partial"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@lucide/angular": "^1.25.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.59.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
